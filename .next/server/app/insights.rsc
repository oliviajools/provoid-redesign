e:["$","article",null,{"className":"border border-border bg-surface p-6 rounded-card hover:border-primary-accent transition-colors h-full flex flex-col","children":[["$","h3",null,{"className":"text-xl font-semibold text-text-primary mb-3 group-hover:text-primary-accent transition-colors","children":"Warum Frauen mit Vitamin-B12-Mangel ein hohes Demenz-Risiko haben"}],["$","p",null,{"className":"text-sm text-text-muted mb-3","children":"2026"}],["$","p",null,{"className":"text-text-secondary line-clamp-3 mb-4 flex-grow","children":"Aktuelle Studien zeigen, dass unser Gehirn sensibler auf Ernährung, biologische Unterschiede und Nährstoffversorgung reagiert als lange angenommen. Frauen scheinen deutlich anfälliger für bestimmte Alzheimer-Risikofaktoren zu sein, selbst \"normale\" Vitamin-B12-Werte könnten bereits mit versteckten Gehirnschäden verbunden sein und ungesunde Ernährung in der Kindheit kann langfristige Veränderungen im Gehirn verursachen."}],["$","div",null,{"className":"flex flex-wrap gap-2 mb-4","children":[[["$","span","Alzheimer",{"className":"text-sm font-medium text-primary-accent bg-white px-2 py-1 rounded-editorial","children":"Alzheimer"}],["$","span","Vitamin B12",{"className":"text-sm font-medium text-primary-accent bg-white px-2 py-1 rounded-editorial","children":"Vitamin B12"}],["$","span","Ernährung",{"className":"text-sm font-medium text-primary-accent bg-white px-2 py-1 rounded-editorial","children":"Ernährung"}]],["$","span",null,{"className":"text-sm text-text-muted","children":["+",2]}]]}],["$","span",null,{"className":"inline-flex items-center gap-2 text-sm font-medium text-primary-accent group-hover:gap-3 transition-all","children":["Weiterlesen",["$","svg",null,{"className":"w-4 h-4","fill":"none","stroke":"currentColor","viewBox":"0 0 24 24","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","strokeWidth":2,"d":"M17 8l4 4m0 0l-4 4m4-4H3"}]}]]}]]}]
f:["$","$L5","wie-eier-und-kaffee-demenz-vermeiden",{"href":"/insights/wie-eier-und-kaffee-demenz-vermeiden","className":"block group","children":["$","article",null,{"className":"border border-border bg-surface p-6 rounded-card hover:border-primary-accent transition-colors h-full flex flex-col","children":[["$","h3",null,{"className":"text-xl font-semibold text-text-primary mb-3 group-hover:text-primary-accent transition-colors","children":"Wie Eier und Kaffee Demenz vermeiden"}],["$","p",null,{"className":"text-sm text-text-muted mb-3","children":"2026"}],["$","p",null,{"className":"text-text-secondary line-clamp-3 mb-4 flex-grow","children":"Aktuelle Studien zeigen, dass unser Gehirn stärker von Neurochemie und Ernährung beeinflusst wird als lange angenommen. Neue psychedelische Wirkstoffe könnten Depressionen behandeln, ohne Halluzinationen auszulösen, moderater Kaffeekonsum steht mit einem deutlich geringeren Demenzrisiko in Verbindung und regelmäßiger Eierkonsum könnte das Alzheimer-Risiko senken."}],["$","div",null,{"className":"flex flex-wrap gap-2 mb-4","children":[[["$","span","Psychedelika",{"className":"text-sm font-medium text-primary-accent bg-white px-2 py-1 rounded-editorial","children":"Psychedelika"}],["$","span","Depression",{"className":"text-sm font-medium text-primary-accent bg-white px-2 py-1 rounded-editorial","children":"Depression"}],["$","span","Kaffee",{"className":"text-sm font-medium text-primary-accent bg-white px-2 py-1 rounded-editorial","children":"Kaffee"}]],["$","span",null,{"className":"text-sm text-text-muted","children":["+",2]}]]}],["$","span",null,{"className":"inline-flex items-center gap-2 text-sm font-medium text-primary-accent group-hover:gap-3 transition-all","children":["Weiterlesen",["$","svg",null,{"className":"w-4 h-4","fill":"none","stroke":"currentColor","viewBox":"0 0 24 24","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","strokeWidth":2,"d":"M17 8l4 4m0 0l-4 4m4-4H3"}]}]]}]]}]}]
10:["$","$L5","was-entscheidet-unser-gehirn-wirklich",{"href":"/insights/was-entscheidet-unser-gehirn-wirklich","className":"block group","children":["$","article",null,{"className":"border border-border bg-surface p-6 rounded-card hover:border-primary-accent transition-colors h-full flex flex-col","children":[["$","h3",null,{"className":"text-xl font-semibold text-text-primary mb-3 group-hover:text-primary-accent transition-colors","children":"Was entscheidet unser Gehirn wirklich?"}],["$","p",null,{"className":"text-sm text-text-muted mb-3","children":"2026"}],["$","p",null,{"className":"text-text-secondary line-clamp-3 mb-4 flex-grow","children":"Neue Studien zeigen, dass unser Gehirn schneller, trainierbarer und gleichzeitig abhängiger von biologischen Prozessen ist als gedacht. Visuelles Training kann Entscheidungen messbar beschleunigen, unser Gehirn bewertet Inhalte bereits in den ersten Sekunden emotional und sozial, und Schlaf entscheidet darüber, ob Informationen überhaupt gespeichert werden."}],["$","div",null,{"className":"flex flex-wrap gap-2 mb-4","children":[[["$","span","Entscheidungsfähigkeit",{"className":"text-sm font-medium text-primary-accent bg-white px-2 py-1 rounded-editorial","children":"Entscheidungsfähigkeit"}],["$","span","Training",{"className":"text-sm font-medium text-primary-accent bg-white px-2 py-1 rounded-editorial","children":"Training"}],["$","span","Schlaf",{"className":"text-sm font-medium text-primary-accent bg-white px-2 py-1 rounded-editorial","children":"Schlaf"}]],["$","span",null,{"className":"text-sm text-text-muted","children":["+",2]}]]}],["$","span",null,{"className":"inline-flex items-center gap-2 text-sm font-medium text-primary-accent group-hover:gap-3 transition-all","children":["Weiterlesen",["$","svg",null,{"className":"w-4 h-4","fill":"none","stroke":"currentColor","viewBox":"0 0 24 24","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","strokeWidth":2,"d":"M17 8l4 4m0 0l-4 4m4-4H3"}]